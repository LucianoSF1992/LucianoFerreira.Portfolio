@page
@model IndexModel
@{
    ViewData["Title"] = "Luciano Silva Ferreira | Desenvolvedor Full Stack .NET";
}

<section class="hero d-flex align-items-center text-center text-white">
    <div class="container">

        <span class="badge bg-light text-dark px-3 py-2 mb-3">
            Disponível para oportunidades • Desenvolvedor Full Stack
        </span>

        <h1 class="hero-title fw-bold" data-i18n="home_hero_name">
            Luciano Silva Ferreira
        </h1>

        <span class="d-block hero-subtitle fw-normal mt-3 text-light" data-i18n="home_hero_subtitle">

            Desenvolvedor Full Stack • .NET • Angular • React • Next.js

        </span>

        <p class="mt-4 hero-description" data-i18n="home_hero_description">

            Desenvolvo aplicações web modernas utilizando ASP.NET Core,
            C#, Angular, React, Next.js e TypeScript,
            criando soluções completas do backend ao frontend,
            com foco em performance, escalabilidade e arquitetura limpa.

        </p>

        <div class="mt-4 d-grid gap-2 d-sm-flex justify-content-center">

            <a class="btn btn-light btn-lg px-4" asp-page="/Projetos">
                Ver Projetos
            </a>

            <a class="btn btn-primary btn-lg px-4" asp-page="/Contato">
                Entrar em contato
            </a>

            <a class="btn btn-outline-light btn-lg px-4" href="https://github.com/LucianoSF1992" target="_blank"
               rel="noopener">

                GitHub

            </a>

            <a class="btn btn-outline-light btn-lg px-4" href="https://www.linkedin.com/in/lucianoferreira92/"
               target="_blank" rel="noopener">

                LinkedIn

            </a>

        </div>

    </div>
</section>

<section class="py-5 bg-light">

    <div class="container">

        <div class="row text-center">

            <div class="col-md-3 col-6 mb-4">

                <h2 class="fw-bold text-primary">4+</h2>

                <p>Projetos Publicados</p>

            </div>

            <div class="col-md-3 col-6 mb-4">

                <h2 class="fw-bold text-primary">15+</h2>

                <p>Tecnologias</p>

            </div>

            <div class="col-md-3 col-6 mb-4">

                <h2 class="fw-bold text-primary">100%</h2>

                <p>Projetos Autorais</p>

            </div>

            <div class="col-md-3 col-6 mb-4">

                <h2 class="fw-bold text-primary">Full Stack</h2>

                <p>Backend • Frontend • Deploy</p>

            </div>

        </div>

    </div>

</section>

<section class="stack py-5">

    <div class="container text-center">

        <h2 class="fw-bold mb-5">

            Tecnologias

        </h2>

        <div class="row">

            <div class="col-lg-3 col-md-4 col-6 mb-4">
                <div class="tech-card p-4 shadow-sm">
                    <h5>.NET 9</h5>
                    <p class="small text-muted">
                        APIs REST e aplicações modernas
                    </p>
                </div>
            </div>

            <div class="col-lg-3 col-md-4 col-6 mb-4">
                <div class="tech-card p-4 shadow-sm">
                    <h5>C#</h5>
                    <p class="small text-muted">
                        Backend orientado a objetos
                    </p>
                </div>
            </div>

            <div class="col-lg-3 col-md-4 col-6 mb-4">
                <div class="tech-card p-4 shadow-sm">
                    <h5>Angular</h5>
                    <p class="small text-muted">
                        SPAs modernas
                    </p>
                </div>
            </div>

            <div class="col-lg-3 col-md-4 col-6 mb-4">
                <div class="tech-card p-4 shadow-sm">
                    <h5>React</h5>
                    <p class="small text-muted">
                        Interfaces modernas
                    </p>
                </div>
            </div>

            <div class="col-lg-3 col-md-4 col-6 mb-4">
                <div class="tech-card p-4 shadow-sm">
                    <h5>Next.js</h5>
                    <p class="small text-muted">
                        Frontend de alta performance
                    </p>
                </div>
            </div>

            <div class="col-lg-3 col-md-4 col-6 mb-4">
                <div class="tech-card p-4 shadow-sm">
                    <h5>TypeScript</h5>
                    <p class="small text-muted">
                        Desenvolvimento escalável
                    </p>
                </div>
            </div>

            <div class="col-lg-3 col-md-4 col-6 mb-4">
                <div class="tech-card p-4 shadow-sm">
                    <h5>SQL Server</h5>
                    <p class="small text-muted">
                        Banco de dados relacional
                    </p>
                </div>
            </div>

            <div class="col-lg-3 col-md-4 col-6 mb-4">
                <div class="tech-card p-4 shadow-sm">
                    <h5>Docker & Linux</h5>
                    <p class="small text-muted">
                        Deploy em produção
                    </p>
                </div>
            </div>

        </div>

    </div>

</section>

<section class="py-5">

    <div class="container">

        <h2 class="text-center fw-bold mb-5">

            Principais Projetos

        </h2>

        <div class="row">

            <div class="col-lg-3 mb-4">

                <div class="card h-100 shadow-sm">

                    <div class="card-body">

                        <h4>DevClub</h4>

                        <p>

                            Plataforma Full Stack desenvolvida com
                            ASP.NET Core, Next.js, React e TypeScript.

                        </p>

                        <a asp-page="/Projetos" class="btn btn-outline-primary">

                            Saiba mais

                        </a>

                    </div>

                </div>

            </div>

            <div class="col-lg-3 mb-4">

                <div class="card h-100 shadow-sm">

                    <div class="card-body">

                        <h4>TreineMais</h4>

                        <p>

                            Plataforma para academias
                            e personal trainers.

                        </p>

                    </div>

                </div>

            </div>

            <div class="col-lg-3 mb-4">

                <div class="card h-100 shadow-sm">

                    <div class="card-body">

                        <h4>AgendaPro</h4>

                        <p>

                            Sistema completo
                            de agendamento online.

                        </p>

                    </div>

                </div>

            </div>

            <div class="col-lg-3 mb-4">

                <div class="card h-100 shadow-sm">

                    <div class="card-body">

                        <h4>StockChef</h4>

                        <p>

                            Plataforma para gestão
                            de estoque de restaurantes.

                        </p>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>

<section class="py-5 text-center bg-dark text-white">

    <div class="container">

        <h2 class="fw-bold">

            Vamos construir algo incrível juntos?

        </h2>

        <p class="mt-3">

            Estou disponível para oportunidades como
            Desenvolvedor Full Stack, Backend .NET ou Frontend.

        </p>

        <a asp-page="/Contato" class="btn btn-light btn-lg mt-3">

            Entrar em contato

        </a>

    </div>

</section>