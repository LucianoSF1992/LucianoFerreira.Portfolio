@page
@model SobreModel
@{
    ViewData["Title"] = "Sobre";
}

<section class="about-hero text-white d-flex align-items-center">
    <div class="container">
        <div class="row align-items-center g-4">

            <!-- FOTO -->
            <div class="col-md-4 text-center">
                <img src="~/images/Luciano.jpg" alt="Luciano Ferreira" class="img-fluid rounded-circle shadow" />
            </div>

            <!-- TEXTO -->
            <div class="col-md-8 text-center text-md-start">

                <span class="badge bg-light text-dark px-3 py-2 mb-3">
                    <span data-i18n="about_role"></span>
                </span>

                <h1 class="display-4 fw-bold mb-3" data-i18n="about_hero_title"></h1>

                <p class="lead mb-4" data-i18n="about_hero_subtitle"></p>

                <div class="d-flex gap-3 justify-content-center justify-content-md-start flex-wrap">

                    <a href="/Contato" class="btn btn-primary btn-lg px-4" data-i18n="about_btn_contact"></a>

                    <a href="/Projetos" class="btn btn-outline-light btn-lg px-4" data-i18n="about_btn_projects"></a>

                </div>

            </div>

        </div>
    </div>
</section>

<section class="py-5">

    <div class="container">

        <div class="row">

            <div class="col-md-8">

                <h3 class="fw-bold mb-3">

                    <span data-i18n="about_name"></span>

                    <span class="text-muted d-block fs-5">

                        <span data-i18n="about_role"></span>

                    </span>

                </h3>

                <p data-i18n="about_text_2"></p>

                <p data-i18n="about_text_3"></p>

                <p data-i18n="about_text_4"></p>

                <p data-i18n="about_text_5"></p>

                <p class="mb-0" data-i18n="about_text_6"></p>

            </div>

            <div class="col-md-4">

                <div class="about-card p-4">

                    <h5 class="fw-bold mb-4" data-i18n="about_skills_title"></h5>

                    <p class="small text-muted" data-i18n="about_backend_title"></p>

                    <ul class="list-unstyled mb-4">

                        <li data-i18n="about_backend_1"></li>
                        <li data-i18n="about_backend_2"></li>
                        <li data-i18n="about_backend_3"></li>
                        <li data-i18n="about_backend_4"></li>
                        <li data-i18n="about_backend_5"></li>
                        <li data-i18n="about_backend_6"></li>

                    </ul>

                    <p class="small text-muted" data-i18n="about_frontend_title"></p>

                    <ul class="list-unstyled mb-4">

                        <li data-i18n="about_frontend_1"></li>
                        <li data-i18n="about_frontend_2"></li>
                        <li data-i18n="about_frontend_3"></li>
                        <li data-i18n="about_frontend_4"></li>
                        <li data-i18n="about_frontend_5"></li>
                        <li data-i18n="about_frontend_6"></li>

                    </ul>

                    <p class="small text-muted" data-i18n="about_devops_title"></p>

                    <ul class="list-unstyled">

                        <li data-i18n="about_devops_1"></li>
                        <li data-i18n="about_devops_2"></li>
                        <li data-i18n="about_devops_3"></li>
                        <li data-i18n="about_devops_4"></li>
                        <li data-i18n="about_devops_5"></li>
                        <li data-i18n="about_devops_6"></li>

                    </ul>

                </div>

            </div>

        </div>

    </div>

</section>