@page
@model SobreModel
@{
    ViewData["Title"] = "Sobre";
}

<section class="about-hero text-white d-flex align-items-center">
    <div class="container">
        <div class="row align-items-center g-4">

            <!-- FOTO -->
            <div class="col-md-4 text-center">
                <img src="~/images/Luciano.jpg" alt="Luciano Ferreira" class="img-fluid rounded-circle shadow" />
            </div>

            <!-- TEXTO -->
            <div class="col-md-8 text-center text-md-start">

                <span class="badge bg-light text-dark px-3 py-2 mb-3">
                    Desenvolvedor Full Stack
                </span>

                <h1 class="display-4 fw-bold mb-3" data-i18n="about_hero_title">

                    Sobre Mim

                </h1>

                <p class="lead mb-4" data-i18n="about_hero_subtitle">

                    Desenvolvedor Full Stack especializado em .NET,
                    criando aplicações modernas com ASP.NET Core,
                    Angular, React e Next.js,
                    do backend ao frontend e deploy em produção.

                </p>

                <div class="d-flex gap-3 justify-content-center justify-content-md-start flex-wrap">

                    <a href="/Contato" class="btn btn-primary btn-lg px-4">

                        🚀 Vamos conversar

                    </a>

                    <a href="/Projetos" class="btn btn-outline-light btn-lg px-4">

                        Ver projetos

                    </a>

                </div>

            </div>

        </div>
    </div>
</section>

<section class="py-5">

    <div class="container">

        <div class="row">

            <div class="col-md-8">

                <h3 class="fw-bold mb-3">

                    Luciano Silva Ferreira

                    <span class="text-muted d-block fs-5">

                        Desenvolvedor Full Stack

                    </span>

                </h3>

                <p>

                    Sou Desenvolvedor Full Stack apaixonado por tecnologia
                    e desenvolvimento de software, com experiência prática
                    na criação de aplicações web completas utilizando
                    .NET, ASP.NET Core, Angular, React, Next.js e TypeScript.

                </p>

                <p>

                    Atuo em todas as etapas do desenvolvimento,
                    desde a modelagem do banco de dados,
                    construção de APIs REST,
                    implementação das regras de negócio,
                    autenticação e autorização,
                    até o desenvolvimento de interfaces modernas
                    e responsivas.

                </p>

                <p>

                    Tenho experiência em deploy de aplicações Linux
                    utilizando Docker, Nginx, PM2 e Systemd,
                    além da utilização de SQL Server,
                    Entity Framework Core,
                    Git/GitHub e boas práticas como
                    Clean Code,
                    SOLID,
                    Arquitetura em Camadas
                    e Clean Architecture.

                </p>

                <p>

                    Atualmente desenvolvo projetos próprios que simulam
                    cenários reais de mercado, como plataformas para
                    academias, agendamento de serviços,
                    gestão de restaurantes
                    e aplicações Full Stack modernas,
                    consolidando experiência prática em diferentes tecnologias.

                </p>

                <p class="mb-0">

                    Meu objetivo é contribuir com equipes que valorizam
                    qualidade de software,
                    aprendizado contínuo
                    e desenvolvimento de soluções escaláveis.

                </p>

            </div>

            <div class="col-md-4">

                <div class="about-card p-4">

                    <h5 class="fw-bold mb-4">

                        Principais Competências

                    </h5>

                    <p class="small text-muted">

                        Backend

                    </p>

                    <ul class="list-unstyled mb-4">

                        <li>✔ C#</li>
                        <li>✔ .NET 9</li>
                        <li>✔ ASP.NET Core</li>
                        <li>✔ Entity Framework Core</li>
                        <li>✔ SQL Server</li>
                        <li>✔ REST APIs</li>

                    </ul>

                    <p class="small text-muted">

                        Frontend

                    </p>

                    <ul class="list-unstyled mb-4">

                        <li>✔ Angular</li>
                        <li>✔ React</li>
                        <li>✔ Next.js</li>
                        <li>✔ TypeScript</li>
                        <li>✔ JavaScript</li>
                        <li>✔ Bootstrap</li>

                    </ul>

                    <p class="small text-muted">

                        Dev & Cloud

                    </p>

                    <ul class="list-unstyled">

                        <li>✔ Docker</li>
                        <li>✔ Linux</li>
                        <li>✔ Nginx</li>
                        <li>✔ PM2</li>
                        <li>✔ Systemd</li>
                        <li>✔ Git / GitHub</li>

                    </ul>

                </div>

            </div>

        </div>

    </div>

</section>