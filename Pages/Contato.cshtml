@page
@model ContatoModel
@{
    ViewData["Title"] = "Contato";
}

<section class="contact-hero text-white text-center d-flex align-items-center">
    <div class="container">
        <h1 class="section-title fw-bold" data-i18n="contact_hero_title">Contato</h1>
        <p class="lead mt-3" data-i18n="contact_hero_subtitle">
            Vamos conversar sobre oportunidades e projetos.
        </p>
    </div>
</section>

<section class="py-5">
    <div class="container">

        @if (!string.IsNullOrEmpty(Model.MensagemSucesso))
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @Model.MensagemSucesso
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div asp-validation-summary="All" class="text-danger"></div>

        <form id="contactForm" method="POST" action="https://formspree.io/f/xlgwvwpj"
              class="contact-card p-4 mx-auto contact-form">

            <div class="mb-3">
                <label class="form-label" data-i18n="contact_label_name">Nome</label>
                <input name="name" class="form-control" required data-i18n-placeholder="contact_placeholder_name"
                       placeholder="Seu nome" />
            </div>

            <div class="mb-3">
                <label class="form-label" data-i18n="contact_label_email">Email</label>
                <input name="email" type="email" class="form-control" required
                       data-i18n-placeholder="contact_placeholder_email" placeholder="Seu melhor email" />
            </div>

            <div class="mb-3">
                <label class="form-label" data-i18n="contact_label_message">Mensagem</label>
                <textarea name="message" class="form-control" rows="4" required
                          data-i18n-placeholder="contact_placeholder_message" placeholder="Digite sua mensagem"></textarea>
            </div>

            <input type="hidden" name="_subject" value="Novo contato do portfólio"
                   data-i18n-subject="contact_email_subject" />

            <div id="formAlert" class="alert d-none mt-3" role="alert"></div>

            <button type="submit" class="btn btn-dark w-100" data-i18n="contact_btn_submit">
                Enviar Mensagem
            </button>

        </form>

    </div>
</section>

<script>
    (function () {
        const form = document.getElementById("contactForm");
        const alertBox = document.getElementById("formAlert");
        const successUrl = "https://www.lucianoferreiradev.com/ContatoSucesso";

        function getCurrentLanguage() {
            return localStorage.getItem("preferredLanguage") || "pt";
        }

        function getTranslation(key) {
            const lang = getCurrentLanguage();
            return window.translations?.[lang]?.[key] || window.translations?.pt?.[key] || key;
        }

        function showAlert(message, type) {
            if (!alertBox) return;
            alertBox.classList.remove("d-none", "alert-success", "alert-danger");
            alertBox.classList.add(type === "success" ? "alert-success" : "alert-danger");
            alertBox.textContent = message;
        }

        if (!form) return;

        form.addEventListener("submit", async function (e) {
            e.preventDefault();

            const submitBtn = form.querySelector('button[type="submit"]');
            const oldText = submitBtn ? submitBtn.textContent : null;

            if (submitBtn) {
                submitBtn.disabled = true;
                submitBtn.textContent = getTranslation("contact_btn_sending");
            }

            try {
                const formData = new FormData(form);

                const response = await fetch(form.action, {
                    method: "POST",
                    body: formData,
                    headers: {
                        "Accept": "application/json"
                    }
                });

                if (response.ok) {
                    window.location.href = successUrl;
                    return;
                }

                let data = null;
                try { data = await response.json(); } catch { }

                const msg = (data && data.errors && data.errors[0] && data.errors[0].message)
                    ? data.errors[0].message
                    : getTranslation("contact_error_default");

                showAlert(msg, "error");
            } catch (err) {
                showAlert(getTranslation("contact_error_connection"), "error");
            } finally {
                if (submitBtn) {
                    submitBtn.disabled = false;
                    submitBtn.textContent = oldText || getTranslation("contact_btn_submit");
                }
            }
        });
    })();
</script>