@page
@model ErrorModel
@{
    ViewData["Title"] = "Erro";
}

<section class="py-5 d-flex align-items-center" style="min-height:75vh;">

    <div class="container">

        <div class="row justify-content-center">

            <div class="col-lg-8">

                <div class="card border-0 shadow rounded-4">

                    <div class="card-body text-center p-5">

                        <i class="bi bi-exclamation-triangle-fill display-1 text-warning mb-4"></i>

                        <h1 class="display-5 fw-bold" data-i18n="error_title">

                            Ocorreu um erro

                        </h1>

                        <p class="lead text-muted mb-4" data-i18n="error_description">

                            Desculpe. Ocorreu um problema ao processar sua solicitação.

                        </p>

                        @if (Model.ShowRequestId)
                        {
                            <div class="alert alert-light border">

                                <strong data-i18n="error_request_id">
                                    ID da Solicitação:
                                </strong>

                                <code>@Model.RequestId</code>

                            </div>
                        }

                        <a asp-page="/Index" class="btn btn-primary btn-lg mt-3">

                            <i class="bi bi-house-door-fill me-2"></i>

                            <span data-i18n="error_back_home">
                                Voltar para a página inicial
                            </span>

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>