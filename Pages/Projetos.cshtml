@page
@model ProjetosModel
@{
    ViewData["Title"] = "Projetos";
}

<section class="projects-hero text-white text-center d-flex align-items-center">
    <div class="container">
        <h1 class="section-title fw-bold">Projetos</h1>
        <p class="lead mt-3">
            Aplicações desenvolvidas com foco em organização, escalabilidade e boas práticas.
        </p>
    </div>
</section>

<section class="py-5">
    <div class="container">

        <h3 class="fw-bold mb-4">🚀 Projetos Principais</h3>

        <div class="row g-4">

            <div class="col-md-6">
                <div class="project-card p-4 h-100">

                    <h5 class="fw-bold">TreineMais — Sistema de Treinos para Academias</h5>

                    <span class="badge bg-success mb-3">MVP concluído</span>

                    <p>
                        Sistema web para academias e personal trainers criarem treinos
                        personalizados, gerenciarem alunos e acompanharem evolução dos exercícios.
                        Possui autenticação com ASP.NET Identity e controle de acesso por perfil.
                    </p>

                    <p class="small text-muted">
                        C# • .NET 8 • ASP.NET Core MVC • EF Core • Identity • SQL Server • Docker • Nginx
                    </p>

                    <div class="d-flex gap-2 flex-wrap mt-3">

                        <a href="https://treinemais.lucianoferreiradev.com" target="_blank"
                               class="btn btn-primary btn-sm">
                            Ver Sistema
                        </a>

                        <a href="https://github.com/LucianoSF1992/TreineMais" target="_blank"
                               class="btn btn-outline-dark btn-sm">
                            GitHub
                        </a>

                    </div>

                </div>
            </div>

            <div class="col-md-6">
                <div class="project-card p-4 h-100">
                    <h5 class="fw-bold">AgendaPro – Sistema de Gestão de Agendamentos</h5>

                    <span class="badge bg-success mb-3">MVP concluído</span>

                    <p>
                        Sistema web para gerenciamento de agendamentos de serviços, com controle de clientes,
                        profissionais, serviços, horários e status de atendimento.
                    </p>

                    <p>
                        Possui autenticação com perfis de acesso, dashboard com indicadores do dia,
                        controle de conflito de horários e relatórios gerenciais por período.
                    </p>

                    <p class="small text-muted">
                        .NET 9 • ASP.NET Core MVC • C# • Entity Framework Core • SQL Server • Bootstrap 5
                    </p>

                    <div class="d-flex gap-2 flex-wrap mt-3">

                        <a href="https://agendapro.lucianoferreiradev.com" target="_blank"
                               class="btn btn-primary btn-sm">
                            Ver Sistema
                        </a>

                        <a href="https://github.com/LucianoSF1992/AgendaPro" target="_blank"
                               class="btn btn-outline-dark btn-sm">
                            GitHub
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="project-card p-4 h-100">
                    <h5 class="fw-bold">Sistema de Controle de Estoque de Restaurantes</h5>

                    <span class="badge bg-secondary mb-3">Planejado</span>

                    <p>
                        Sistema web para controlar o estoque de restaurantes.
                    </p>

                    <p class="small text-muted">
                        C# • ASP.NET Core • SQL Server
                    </p>
                </div>
            </div>

        </div>

        <hr class="my-5" />

        <h3 class="fw-bold mb-4">💻 Outros Projetos</h3>

        <div class="project-card p-4">
            <h5 class="fw-bold">Repositórios no GitHub</h5>
            <p>
                Aplicações web, APIs REST e projetos práticos desenvolvidos
                com foco em aprendizado contínuo e boas práticas.
            </p>

            <a href="https://github.com/LucianoSF1992" target="_blank" rel="noopener"
                   class="btn btn-dark btn-sm project-btn">
                Ver no GitHub
            </a>
        </div>

    </div>
</section>