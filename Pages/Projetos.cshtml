@page
@model ProjetosModel
@{
    ViewData["Title"] = "Projetos";
}

<section class="projects-hero text-white text-center d-flex align-items-center">
    <div class="container">
        <h1 class="section-title fw-bold" data-i18n="projects_hero_title"></h1>
        <p class="lead mt-3" data-i18n="projects_hero_subtitle"></p>
    </div>
</section>

<section class="py-5">
    <div class="container">

        <h3 class="fw-bold mb-4" data-i18n="projects_featured_title"></h3>

        <div class="row g-4">

            <!-- DevClub -->
            <div class="col-md-6">
                <div class="project-card p-4 h-100">

                    <h5 class="fw-bold" data-i18n="project_devclub_title"></h5>

                    <span class="badge bg-success mb-3" data-i18n="project_status_published"></span>

                    <p data-i18n="project_devclub_desc_1"></p>

                    <p data-i18n="project_devclub_desc_2"></p>

                    <p class="small text-muted">
                        Next.js • React • TypeScript • Tailwind CSS • ASP.NET Core • Entity Framework Core • SQLite •
                        Linux • Nginx • PM2 • Systemd
                    </p>

                    <div class="d-flex gap-2 flex-wrap mt-3">
                        <a href="https://devclub.lucianoferreiradev.com" target="_blank" class="btn btn-primary btn-sm"
                           data-i18n="project_btn_system">
                        </a>

                        <a href="https://github.com/LucianoSF1992/devclub-concurso" target="_blank"
                           class="btn btn-outline-dark btn-sm" data-i18n="project_btn_github">
                        </a>
                    </div>

                </div>
            </div>

            <!-- TreineMais -->
            <div class="col-md-6">
                <div class="project-card p-4 h-100">

                    <h5 class="fw-bold" data-i18n="project_treinemais_title"></h5>

                    <span class="badge bg-success mb-3" data-i18n="project_status_done"></span>

                    <p data-i18n="project_treinemais_desc"></p>

                    <p class="small text-muted">
                        C# • .NET 8 • ASP.NET Core MVC • EF Core • Identity • SQL Server • Docker • Nginx
                    </p>

                    <div class="d-flex gap-2 flex-wrap mt-3">

                        <a href="https://treinemais.lucianoferreiradev.com" target="_blank"
                           class="btn btn-primary btn-sm" data-i18n="project_btn_system">
                        </a>

                        <a href="https://github.com/LucianoSF1992/TreineMais" target="_blank"
                           class="btn btn-outline-dark btn-sm" data-i18n="project_btn_github">
                        </a>

                    </div>

                </div>
            </div>

            <!-- AgendaPro -->
            <div class="col-md-6">
                <div class="project-card p-4 h-100">

                    <h5 class="fw-bold" data-i18n="project_agendapro_title"></h5>

                    <span class="badge bg-success mb-3" data-i18n="project_status_done"></span>

                    <p data-i18n="project_agendapro_desc_1"></p>

                    <p data-i18n="project_agendapro_desc_2"></p>

                    <p class="small text-muted">
                        .NET 9 • ASP.NET Core MVC • C# • Entity Framework Core • SQL Server • Bootstrap 5
                    </p>

                    <div class="d-flex gap-2 flex-wrap mt-3">

                        <a href="https://agendapro.lucianoferreiradev.com" target="_blank"
                           class="btn btn-primary btn-sm" data-i18n="project_btn_system">
                        </a>

                        <a href="https://github.com/LucianoSF1992/AgendaPro" target="_blank"
                           class="btn btn-outline-dark btn-sm" data-i18n="project_btn_github">
                        </a>

                    </div>

                </div>
            </div>

            <!-- StockChef -->
            <div class="col-md-6">
                <div class="project-card p-4 h-100">

                    <h5 class="fw-bold" data-i18n="project_stockchef_title"></h5>

                    <span class="badge bg-warning text-dark mb-3" data-i18n="project_status_development"></span>

                    <p data-i18n="project_stockchef_desc_1"></p>

                    <p data-i18n="project_stockchef_desc_2"></p>

                    <p class="small text-muted">
                        .NET 9 • ASP.NET Core • Angular • TypeScript • Entity Framework Core • SQL Server • REST API •
                        Clean Architecture
                    </p>

                    <div class="d-flex gap-2 flex-wrap mt-3">
                        <a href="https://github.com/LucianoSF1992/stockchef-platform" target="_blank"
                           class="btn btn-outline-dark btn-sm" data-i18n="project_btn_github">
                        </a>
                    </div>

                </div>
            </div>

        </div>

    </div>
</section>