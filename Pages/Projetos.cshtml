@page
@model ProjetosModel
@{
    ViewData["Title"] = "Projetos";
}

<section class="projects-hero text-white text-center d-flex align-items-center">
    <div class="container">
        <h1 class="section-title fw-bold" data-i18n="projects_hero_title">Projetos</h1>
        <p class="lead mt-3">
            Aplicações Full Stack desenvolvidas para resolver problemas reais, utilizando tecnologias modernas,
            arquitetura escalável e boas práticas de desenvolvimento.
        </p>
    </div>
</section>

<section class="py-5">
    <div class="container">

        <h3 class="fw-bold mb-4">🚀 Projetos em Destaque</h3>

        <div class="row g-4">

            <!-- DevClub -->
            <div class="col-md-6">
                <div class="project-card p-4 h-100">

                    <h5 class="fw-bold">
                        DevClub Next Level — Plataforma Full Stack de Ensino
                    </h5>

                    <span class="badge bg-success mb-3">Publicado</span>

                    <p>
                        Plataforma Full Stack desenvolvida para o concurso de Desenvolvedor Full Stack da DevClub.
                        Possui autenticação de usuários, área do aluno, catálogo de cursos, páginas institucionais,
                        formulário de contato integrado com API REST e interface moderna totalmente responsiva.
                    </p>

                    <p>
                        Desenvolvido com frontend em Next.js e backend em ASP.NET Core,
                        aplicando boas práticas de arquitetura, autenticação,
                        consumo de APIs e deploy em ambiente Linux.
                    </p>

                    <p class="small text-muted">
                        Next.js • React • TypeScript • Tailwind CSS • ASP.NET Core • Entity Framework Core • SQLite •
                        Linux • Nginx • PM2 • Systemd
                    </p>

                    <div class="d-flex gap-2 flex-wrap mt-3">
                        <a href="https://devclub.lucianoferreiradev.com" target="_blank" class="btn btn-primary btn-sm">
                            Ver Sistema
                        </a>

                        <a href="https://github.com/LucianoSF1992/devclub-concurso" target="_blank"
                           class="btn btn-outline-dark btn-sm">
                            GitHub
                        </a>
                    </div>

                </div>
            </div>

            <!-- TreineMais -->
            <div class="col-md-6">
                <div class="project-card p-4 h-100">

                    <h5 class="fw-bold" data-i18n="project_treinemais_title">
                        TreineMais — Sistema de Treinos para Academias
                    </h5>

                    <span class="badge bg-success mb-3" data-i18n="project_status_done">MVP concluído</span>

                    <p data-i18n="project_treinemais_desc">
                        Sistema web para academias e personal trainers criarem treinos personalizados, gerenciarem
                        alunos e acompanharem a evolução dos exercícios. Possui autenticação com ASP.NET Identity e
                        controle de acesso por perfil.
                    </p>

                    <p class="small text-muted">
                        C# • .NET 8 • ASP.NET Core MVC • EF Core • Identity • SQL Server • Docker • Nginx
                    </p>

                    <div class="d-flex gap-2 flex-wrap mt-3">

                        <a href="https://treinemais.lucianoferreiradev.com" target="_blank"
                           class="btn btn-primary btn-sm" data-i18n="project_btn_system">
                            Ver Sistema
                        </a>

                        <a href="https://github.com/LucianoSF1992/TreineMais" target="_blank"
                           class="btn btn-outline-dark btn-sm" data-i18n="project_btn_github">
                            GitHub
                        </a>

                    </div>

                </div>
            </div>

            <!-- AgendaPro -->
            <div class="col-md-6">
                <div class="project-card p-4 h-100">
                    <h5 class="fw-bold" data-i18n="project_agendapro_title">
                        AgendaPro – Sistema de Gestão de Agendamentos
                    </h5>

                    <span class="badge bg-success mb-3" data-i18n="project_status_done">MVP concluído</span>

                    <p data-i18n="project_agendapro_desc_1">
                        Sistema web para gerenciamento de agendamentos de serviços, com controle de clientes,
                        profissionais, serviços, horários e status de atendimento.
                    </p>

                    <p data-i18n="project_agendapro_desc_2">
                        Possui autenticação com perfis de acesso, dashboard com indicadores do dia, controle de conflito
                        de horários e relatórios gerenciais por período.
                    </p>

                    <p class="small text-muted">
                        .NET 9 • ASP.NET Core MVC • C# • Entity Framework Core • SQL Server • Bootstrap 5
                    </p>

                    <div class="d-flex gap-2 flex-wrap mt-3">

                        <a href="https://agendapro.lucianoferreiradev.com" target="_blank"
                           class="btn btn-primary btn-sm" data-i18n="project_btn_system">
                            Ver Sistema
                        </a>

                        <a href="https://github.com/LucianoSF1992/AgendaPro" target="_blank"
                           class="btn btn-outline-dark btn-sm" data-i18n="project_btn_github">
                            GitHub
                        </a>
                    </div>
                </div>
            </div>

            <!-- StockChef -->
            <div class="col-md-6">
                <div class="project-card p-4 h-100">

                    <h5 class="fw-bold">
                        StockChef Platform — Sistema de Gestão para Restaurantes
                    </h5>

                    <span class="badge bg-warning text-dark mb-3">
                        Em desenvolvimento
                    </span>

                    <p>
                        Plataforma Full Stack para gerenciamento de estoque de restaurantes,
                        desenvolvida com arquitetura limpa, separação em camadas e APIs REST.
                        O projeto contempla controle de produtos, categorias, movimentações,
                        fornecedores e gestão operacional.
                    </p>

                    <p>
                        O frontend está sendo desenvolvido em Angular e o backend em ASP.NET Core,
                        seguindo princípios de Clean Architecture, SOLID e Domain-Driven Design.
                    </p>

                    <p class="small text-muted">
                        .NET 9 • ASP.NET Core • Angular • TypeScript • Entity Framework Core • SQL Server • REST API •
                        Clean Architecture
                    </p>

                    <div class="d-flex gap-2 flex-wrap mt-3">
                        <a href="https://github.com/LucianoSF1992/stockchef-platform" target="_blank"
                           class="btn btn-outline-dark btn-sm">
                            GitHub
                        </a>
                    </div>

                </div>
            </div>

        </div>

    </div>
</section>
